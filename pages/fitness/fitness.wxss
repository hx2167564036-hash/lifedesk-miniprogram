/* 母题：图书馆索引卡 | 与 index / homework 同色板 */
page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 60rpx; }

.card {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  padding: 28rpx 32rpx;
  position: relative;
}
.card-rule {
  position: absolute;
  top: 0; left: 32rpx; right: 32rpx;
  height: 6rpx;
  background: #A4332B;
}
.fit-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 14rpx 0 24rpx;
}
.card-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
}
.card-no { font-size: 18rpx; color: #6E685C; letter-spacing: 3rpx; font-variant-numeric: tabular-nums; }

/* ===== 身体数据三联 ===== */
.fit-nums { display: flex; align-items: flex-end; }
.fn-item { flex: 1; }
.fn-num {
  display: block;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 52rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.fn-cap {
  font-size: 19rpx;
  color: #6E685C;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.fn-div { width: 1rpx; height: 64rpx; background: #DAD4C6; margin: 0 24rpx; }

.fit-chart { margin-top: 28rpx; }
.fit-canvas { width: 100%; height: 220rpx; }
.fit-chart-cap {
  display: block;
  font-size: 18rpx;
  color: #6E685C;
  text-align: right;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

/* ===== 分区 ===== */
.section { margin-top: 48rpx; }
.sec-head {
  display: flex;
  align-items: baseline;
  border-bottom: 1rpx solid #22201C;
  padding-bottom: 10rpx;
  margin-bottom: 8rpx;
}
.sec-label { font-size: 20rpx; letter-spacing: 6rpx; color: #6E685C; flex: 1; }
.sec-count { font-size: 20rpx; color: #6E685C; font-variant-numeric: tabular-nums; }

/* ===== 目标进度 ===== */
.goal-bar {
  height: 14rpx;
  background: #DAD4C6;
  margin: 20rpx 0 12rpx;
  position: relative;
}
.goal-fill {
  height: 100%;
  background: #A4332B;
  transition: width 200ms cubic-bezier(0.2, 0, 0, 1);
}
.goal-meta { display: flex; justify-content: space-between; font-size: 20rpx; color: #6E685C; }

/* ===== 饮食运动 ===== */
.cal-row { display: flex; gap: 24rpx; padding-top: 16rpx; }
.cal-item { flex: 1; }
.cal-label { display: block; font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 10rpx; }
.cal-input { font-size: 34rpx; font-weight: 600; }

/* ===== 周计划 ===== */
.day-col {
  border-bottom: 1rpx solid #DAD4C6;
  padding: 16rpx 0;
}
.day-col.today { background: rgba(162, 64, 42, 0.05); }
.dc-name {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-bottom: 10rpx;
}
.dc-today {
  font-size: 17rpx;
  color: #A4332B;
  border: 1rpx solid #A4332B;
  padding: 0 8rpx;
  margin-left: 12rpx;
  letter-spacing: 2rpx;
}
.plan-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
}
.pi-name { flex: 1; }
.pi-del { font-size: 26rpx; color: #C9C2B4; padding: 0 12rpx; }
.pa-input {
  font-size: 22rpx;
  color: #6E685C;
  border-bottom: 1rpx dashed #DAD4C6;
  padding: 8rpx 0;
}

.ops { margin-top: 32rpx; }
.btn {
  background: #EFEBE0;
  border: 1rpx solid #22201C;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #22201C;
  letter-spacing: 4rpx;
}
.btn.primary { background: #22201C; color: #EFEBE0; }
.btn.add-btn { width: calc(100% - 72rpx); margin-left: 36rpx; border-style: dashed; }

/* ===== 弹层 ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(34, 32, 28, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #E7E2D6;
  border: 1rpx solid #DAD4C6;
  border-bottom: none;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #22201C;
}
.fl { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.field {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  border-radius: 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}
.form-2col { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.form-col { flex: 1; }
.sheet-ops { display: flex; gap: 20rpx; }
