/* 母题：图书馆索引卡 | 与 index / homework 同色板 */
page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 60rpx; }

.card {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  padding: 28rpx 32rpx;
  position: relative;
}
.card-rule {
  position: absolute;
  top: 0; left: 32rpx; right: 32rpx;
  height: 6rpx;
  background: #A4332B;
}

/* ===== GPA 主卡：超大数字 ===== */
.gpa-cap {
  display: block;
  font-size: 20rpx;
  color: #6E685C;
  letter-spacing: 6rpx;
  margin: 14rpx 0 4rpx;
}
.gpa-num-row { display: flex; align-items: baseline; }
.gpa-num {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 128rpx;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}
.gpa-max { font-size: 24rpx; color: #6E685C; margin-left: 12rpx; font-variant-numeric: tabular-nums; }
.gpa-meta { display: flex; gap: 40rpx; margin-top: 16rpx; }
.gm-item { font-size: 21rpx; color: #6E685C; }
.gm-item .mono { color: #22201C; font-weight: 600; }
.gpa-formula {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #DAD4C6;
  font-size: 19rpx;
  color: #6E685C;
}

/* ===== 分区 ===== */
.section { margin-top: 48rpx; }
.sec-head {
  display: flex;
  align-items: baseline;
  border-bottom: 1rpx solid #22201C;
  padding-bottom: 10rpx;
  margin-bottom: 8rpx;
}
.sec-label { font-size: 20rpx; letter-spacing: 6rpx; color: #6E685C; flex: 1; }
.sec-count { font-size: 20rpx; color: #6E685C; font-variant-numeric: tabular-nums; }

/* ===== 学期 chips ===== */
.term-chips { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 20rpx 0 4rpx; }
.chip {
  font-size: 21rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 6rpx 22rpx;
  letter-spacing: 2rpx;
}
.chip.active { color: #22201C; border-color: #22201C; font-weight: 600; }

/* ===== 成绩行 ===== */
.g-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.g-main { flex: 1; }
.g-name { display: block; font-size: 26rpx; }
.g-term { display: block; font-size: 19rpx; color: #6E685C; margin-top: 3rpx; font-variant-numeric: tabular-nums; }
.g-credit { font-size: 21rpx; color: #6E685C; width: 100rpx; text-align: right; }
.g-score { font-size: 28rpx; font-weight: 600; width: 90rpx; text-align: right; }
.g-point {
  font-size: 22rpx;
  color: #A4332B;
  width: 80rpx;
  text-align: right;
}
.g-del { font-size: 30rpx; color: #C9C2B4; padding-left: 16rpx; }

.empty {
  text-align: center;
  color: #6E685C;
  font-size: 22rpx;
  padding: 60rpx 0;
  letter-spacing: 2rpx;
}
.add-btn { margin-top: 32rpx; border-style: dashed; }

/* ===== 弹层 ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(34, 32, 28, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #E7E2D6;
  border: 1rpx solid #DAD4C6;
  border-bottom: none;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #22201C;
}
.form-row { margin-bottom: 20rpx; }
.fl { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.field {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  border-radius: 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}
.form-2col { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.form-col { flex: 1; }
.form-tip { font-size: 20rpx; color: #6E685C; margin-bottom: 24rpx; }
.form-tip .mono { color: #A4332B; font-weight: 600; }
.sheet-ops { display: flex; gap: 20rpx; }
.btn {
  flex: 1;
  background: #EFEBE0;
  border: 1rpx solid #22201C;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #22201C;
  letter-spacing: 4rpx;
}
.btn.primary { background: #22201C; color: #EFEBE0; }
.btn.add-btn { width: calc(100% - 72rpx); margin-left: 36rpx; }
