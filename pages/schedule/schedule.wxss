/* 母题：图书馆索引卡 | 与 index / homework 同色板 */
page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 60rpx; }

.section { margin-bottom: 48rpx; }
.sec-head {
  display: flex;
  align-items: baseline;
  border-bottom: 1rpx solid #22201C;
  padding-bottom: 10rpx;
  margin-bottom: 8rpx;
}
.sec-label { font-size: 20rpx; letter-spacing: 6rpx; color: #6E685C; flex: 1; }
.sec-count { font-size: 20rpx; color: #6E685C; font-variant-numeric: tabular-nums; }

/* ===== 日程行 ===== */
.sc-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.sc-check {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid #C9C2B4;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #EFEBE0;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: background 160ms cubic-bezier(0.2, 0, 0, 1);
}
.sc-check.on { background: #3A5A40; border-color: #3A5A40; }
.sc-main { flex: 1; }
.sc-title { display: block; font-size: 27rpx; }
.sc-title.done { color: #6E685C; text-decoration: line-through; }
.sc-sub { display: block; font-size: 20rpx; color: #6E685C; margin-top: 4rpx; }
.roll-tag {
  font-size: 18rpx;
  color: #A4332B;
  border: 1rpx solid #A4332B;
  padding: 0 10rpx;
  margin-left: 10rpx;
  transform: rotate(-3deg);
  display: inline-block;
}
.sc-del { font-size: 30rpx; color: #C9C2B4; padding-left: 12rpx; }

/* ===== 日期分组 ===== */
.day-group { margin-bottom: 24rpx; }
.dg-head {
  display: flex;
  align-items: baseline;
  padding: 14rpx 0 6rpx;
}
.dg-date {
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  margin-right: 14rpx;
}
.dg-week { font-size: 19rpx; color: #6E685C; flex: 1; }
.dg-today {
  font-size: 18rpx;
  color: #A4332B;
  border: 1rpx solid #A4332B;
  padding: 0 10rpx;
  letter-spacing: 2rpx;
}

.empty {
  text-align: center;
  color: #6E685C;
  font-size: 22rpx;
  padding: 60rpx 0;
  letter-spacing: 2rpx;
}
.add-btn { margin-top: 16rpx; border-style: dashed; }

/* ===== 弹层 ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(34, 32, 28, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #E7E2D6;
  border: 1rpx solid #DAD4C6;
  border-bottom: none;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #22201C;
}
.form-row { margin-bottom: 20rpx; }
.fl { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.field {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  border-radius: 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}
.form-2col { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.form-col { flex: 1; }
.prio-chips { display: flex; gap: 16rpx; }
.chip {
  font-size: 21rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 6rpx 24rpx;
  letter-spacing: 2rpx;
}
.chip.active { color: #22201C; border-color: #22201C; font-weight: 600; }
.sheet-ops { display: flex; gap: 20rpx; }
.btn {
  flex: 1;
  background: #EFEBE0;
  border: 1rpx solid #22201C;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #22201C;
  letter-spacing: 4rpx;
}
.btn.primary { background: #22201C; color: #EFEBE0; }
.btn.add-btn { width: calc(100% - 72rpx); margin-left: 36rpx; }
