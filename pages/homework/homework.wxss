/* 母题：图书馆索引卡 | 与 index 页同色板同字体策略 */
page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 60rpx; }

/* ===== 统计条 ===== */
.stat-strip {
  display: flex;
  align-items: flex-end;
  padding: 24rpx 28rpx;
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  position: relative;
}
.stat-strip::before {
  content: '';
  position: absolute;
  top: 0; left: 28rpx; right: 28rpx;
  height: 6rpx;
  background: #A4332B;
}
.ss-item { flex: 1; }
.ss-num {
  display: block;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 56rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.ss-num.danger { color: #A4332B; }
.ss-cap { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-top: 8rpx; display: block; }
.ss-div { width: 1rpx; height: 64rpx; background: #DAD4C6; margin: 0 24rpx; }

/* ===== 筛选 ===== */
.filter-row { display: flex; gap: 16rpx; margin: 32rpx 0 8rpx; }
.chip {
  font-size: 22rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 6rpx 24rpx;
  letter-spacing: 2rpx;
}
.chip.active { color: #22201C; border-color: #22201C; font-weight: 600; }

/* ===== 作业行 ===== */
.hw-list { margin-top: 8rpx; }
.hw-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.hw-check {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid #C9C2B4;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #EFEBE0;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: background 160ms cubic-bezier(0.2, 0, 0, 1);
}
.hw-check.on { background: #3A5A40; border-color: #3A5A40; }
.hw-main { flex: 1; }
.hw-title { display: block; font-size: 27rpx; }
.hw-title.done { color: #6E685C; text-decoration: line-through; }
.hw-sub { display: block; font-size: 20rpx; color: #6E685C; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.hw-right { display: flex; flex-direction: column; align-items: flex-end; gap: 10rpx; }
.hw-stamp {
  font-size: 19rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 3rpx;
  transform: rotate(-3deg);
}
.hw-stamp.danger { color: #A4332B; border: 1rpx solid #A4332B; }
.hw-stamp.warn { color: #B8862B; border: 1rpx solid #B8862B; }
.hw-stamp.ok { color: #6E685C; border: 1rpx solid #DAD4C6; }
.hw-stamp.done { color: #3A5A40; border: 1rpx solid #3A5A40; }
.hw-del { font-size: 19rpx; color: #B9B2A4; }

.empty {
  text-align: center;
  color: #6E685C;
  font-size: 22rpx;
  padding: 80rpx 0;
  letter-spacing: 2rpx;
}
.add-btn { margin-top: 32rpx; }

/* ===== 弹层 ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(34, 32, 28, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #E7E2D6;
  border: 1rpx solid #DAD4C6;
  border-bottom: none;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #22201C;
}
.form-row { margin-bottom: 20rpx; }
.fl { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.field {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  border-radius: 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}
.sheet-ops { display: flex; gap: 20rpx; margin-top: 8rpx; }
.btn {
  flex: 1;
  background: #EFEBE0;
  border: 1rpx solid #22201C;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #22201C;
  letter-spacing: 4rpx;
}
.btn.primary { background: #22201C; color: #EFEBE0; }
.btn.add-btn { width: calc(100% - 72rpx); margin-left: 36rpx; border-style: dashed; }
