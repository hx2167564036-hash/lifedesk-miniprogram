/* 母题：图书馆索引卡 | 色板：卡纸 #EFEBE0 / 纸底 #E7E2D6 / 墨水 #22201C / 铅笔灰 #6E685C / 分割线 #DAD4C6 / 索引红 #A4332B（唯一爆发色） | 字体策略：衬线标题（Georgia+宋体栈）建立编辑感，正文系统无衬线，数字全等宽 tabular-nums，无外部字体 */

page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 300rpx; }

/* ===== 索引编号行 ===== */
.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #DAD4C6;
}
.meta-no {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #6E685C;
  font-variant-numeric: tabular-nums;
}
.meta-status { display: flex; align-items: center; }
.status-dot {
  width: 10rpx; height: 10rpx;
  background: #3A5A40;
  border-radius: 50%;
  margin-right: 10rpx;
}
.meta-mode { font-size: 20rpx; color: #6E685C; letter-spacing: 2rpx; }

/* ===== 日期区：破网格，超大数字出血 ===== */
.date-block {
  position: relative;
  overflow: hidden;
  padding: 36rpx 0 28rpx;
}
.date-week {
  display: block;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 72rpx;
  font-weight: 400;
  line-height: 1;
  letter-spacing: 8rpx;
}
.date-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 12rpx;
  color: #6E685C;
  margin-top: 18rpx;
}
.date-bleed {
  position: absolute;
  right: -24rpx;
  bottom: -56rpx;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 220rpx;
  font-weight: 400;
  line-height: 1;
  color: #DAD4C6;
  font-variant-numeric: tabular-nums;
  pointer-events: none;
}

/* ===== 索引卡通用 ===== */
.card {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  padding: 28rpx 32rpx;
  position: relative;
}
.card-rule {
  position: absolute;
  top: 0; left: 32rpx; right: 32rpx;
  height: 6rpx;
  background: #A4332B;
}
.focus-card {
  box-shadow: 0 2rpx 0 rgba(34, 32, 28, 0.06); /* 全页唯一阴影 */
}
.focus-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 14rpx 0 24rpx;
}
.card-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 34rpx;
  letter-spacing: 4rpx;
}
.card-no {
  font-size: 18rpx;
  color: #6E685C;
  letter-spacing: 2rpx;
  font-variant-numeric: tabular-nums;
}

/* ===== 指数环（色彩爆发） ===== */
.focus-body { display: flex; align-items: center; }
.ring-wrap { position: relative; width: 200rpx; height: 200rpx; }
.ring { width: 200rpx; height: 200rpx; }
.ring-center {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.ring-num {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 72rpx;
  line-height: 1;
  color: #A4332B;
  font-variant-numeric: tabular-nums;
}
.ring-cap { font-size: 20rpx; color: #6E685C; margin-top: 6rpx; font-variant-numeric: tabular-nums; }
.focus-meta { flex: 1; padding-left: 36rpx; }
.fm-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.fm-row:last-child { border-bottom: none; }
.fm-k { font-size: 22rpx; color: #6E685C; letter-spacing: 2rpx; }
.fm-v { font-size: 26rpx; font-weight: 600; font-variant-numeric: tabular-nums; }

.focus-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #DAD4C6;
  display: flex;
  align-items: baseline;
}
.fn-label {
  font-size: 18rpx;
  color: #A4332B;
  letter-spacing: 4rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.fn-text { font-size: 23rpx; color: #22201C; line-height: 1.6; }

/* ===== 分区标题 ===== */
.section { margin-top: 48rpx; }
.sec-head {
  display: flex;
  align-items: baseline;
  border-bottom: 1rpx solid #22201C;
  padding-bottom: 10rpx;
  margin-bottom: 8rpx;
}
.sec-label { font-size: 20rpx; letter-spacing: 6rpx; color: #6E685C; flex: 1; }
.sec-count { font-size: 20rpx; color: #6E685C; font-variant-numeric: tabular-nums; }

/* ===== 任务行：索引卡行式 ===== */
.task-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.task-no {
  font-size: 22rpx;
  color: #6E685C;
  width: 56rpx;
  font-variant-numeric: tabular-nums;
}
.task-main { flex: 1; }
.task-title { display: block; font-size: 27rpx; }
.task-sub { display: block; font-size: 20rpx; color: #6E685C; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.task-tag {
  font-size: 19rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 2rpx 12rpx;
  letter-spacing: 2rpx;
}
.task-stamp {
  font-size: 19rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 4rpx;
  transform: rotate(-3deg);
}
.task-stamp.danger { color: #A4332B; border: 1rpx solid #A4332B; }
.task-stamp.today { color: #3A5A40; border: 1rpx solid #3A5A40; }

/* ===== 空态 ===== */
.task-empty {
  padding: 48rpx 0 56rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.te-line { font-size: 26rpx; color: #6E685C; }
.te-hint { font-size: 20rpx; color: #B9B2A4; line-height: 1.6; }

/* ===== 入口：纵向索引条目 ===== */
.entry-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
  transition: transform 160ms cubic-bezier(0.2, 0, 0, 1);
}
.entry-pressed { transform: scale(0.985); }
.entry-idx {
  width: 56rpx;
  font-size: 22rpx;
  color: #6E685C;
  font-variant-numeric: tabular-nums;
}
.entry-name { font-size: 27rpx; width: 140rpx; }
.entry-desc { flex: 1; font-size: 20rpx; color: #6E685C; font-variant-numeric: tabular-nums; }
.entry-arrow { font-size: 26rpx; color: #6E685C; }

/* ===== 底部统计 ===== */
.footer-stats {
  margin-top: 56rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #22201C;
  display: flex;
  align-items: flex-end;
}
.fs-item { flex: 1; }
.fs-label {
  display: block;
  font-size: 19rpx;
  color: #6E685C;
  letter-spacing: 3rpx;
  margin-bottom: 8rpx;
}
.fs-num {
  font-size: 34rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.fs-div { width: 1rpx; height: 56rpx; background: #DAD4C6; margin: 0 28rpx; }

/* ===== 收集箱：打孔钮 ===== */
.fab {
  position: fixed;
  right: 28rpx;
  bottom: calc(150rpx + env(safe-area-inset-bottom));
  z-index: 95;
  display: flex; align-items: center;
  background: #22201C;
  color: #EFEBE0;
  border-radius: 4rpx;
  padding: 14rpx 26rpx;
  transition: transform 140ms cubic-bezier(0.2, 0, 0, 1);
}
.fab-pressed { transform: scale(0.96); }
.fab-plus { font-size: 28rpx; font-weight: 300; margin-right: 10rpx; }
.fab-text { font-size: 24rpx; letter-spacing: 2rpx; }
