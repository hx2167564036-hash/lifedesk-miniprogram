/* 母题：图书馆索引卡 | 与 index / homework 同色板 */
page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 60rpx; }

/* ===== 统计条 ===== */
.stat-strip {
  display: flex;
  align-items: flex-end;
  padding: 24rpx 28rpx;
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  position: relative;
}
.stat-strip::before {
  content: '';
  position: absolute;
  top: 0; left: 28rpx; right: 28rpx;
  height: 6rpx;
  background: #A4332B;
}
.ss-item { flex: 1; }
.ss-num {
  display: block;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 48rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.ss-cap { font-size: 19rpx; color: #6E685C; letter-spacing: 3rpx; margin-top: 8rpx; display: block; }
.ss-div { width: 1rpx; height: 60rpx; background: #DAD4C6; margin: 0 20rpx; }

/* ===== 视图切换 ===== */
.view-switch { display: flex; gap: 16rpx; margin: 32rpx 0 8rpx; }
.vs-chip {
  font-size: 22rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 6rpx 24rpx;
  letter-spacing: 2rpx;
}
.vs-chip.active { color: #22201C; border-color: #22201C; font-weight: 600; }

/* ===== 封面墙 ===== */
.wall {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 16rpx;
}
.wtile { display: flex; flex-direction: column; }
.wt-cover {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 133.33%; /* 3:4 比例（padding 技巧，兼容旧版 WebView，不用 aspect-ratio） */
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  overflow: hidden;
}
.wt-img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
}
.wt-initial {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 56rpx;
  color: #C9C2B4;
}
.wt-status {
  position: absolute;
  left: 0; bottom: 0;
  font-size: 16rpx;
  color: #EFEBE0;
  background: rgba(34, 32, 28, 0.72);
  padding: 2rpx 10rpx;
  letter-spacing: 1rpx;
}
.wt-meta { padding: 10rpx 2rpx 0; }
.wt-title {
  display: block;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.wt-stars { display: block; font-size: 18rpx; color: #B8862B; margin-top: 2rpx; letter-spacing: 2rpx; }

/* ===== 列表 ===== */
.ml-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.ml-title { display: block; font-size: 27rpx; }
.ml-sub { display: block; font-size: 20rpx; color: #6E685C; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.ml-review { display: block; font-size: 21rpx; color: #6E685C; margin-top: 8rpx; line-height: 1.6; }

.empty {
  text-align: center;
  color: #6E685C;
  font-size: 22rpx;
  padding: 60rpx 0;
  letter-spacing: 2rpx;
}
.add-btn { margin-top: 32rpx; border-style: dashed; }

/* ===== 弹层 ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(34, 32, 28, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #E7E2D6;
  border: 1rpx solid #DAD4C6;
  border-bottom: none;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  overflow-y: auto;
}
.sheet-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #22201C;
}
.form-row { margin-bottom: 20rpx; }
.fl { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.field {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  border-radius: 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}
.type-chips { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  font-size: 21rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 6rpx 22rpx;
  letter-spacing: 2rpx;
}
.chip.active { color: #22201C; border-color: #22201C; font-weight: 600; }
.star-row { display: flex; gap: 12rpx; }
.star { font-size: 44rpx; color: #DAD4C6; }
.star.on { color: #B8862B; }
.sheet-ops { display: flex; gap: 20rpx; margin-top: 8rpx; }
.btn {
  flex: 1;
  background: #EFEBE0;
  border: 1rpx solid #22201C;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #22201C;
  letter-spacing: 4rpx;
}
.btn.primary { background: #22201C; color: #EFEBE0; }
.btn.danger-text { color: #A4332B; border-color: #A4332B; }
.btn.add-btn { width: calc(100% - 72rpx); margin-left: 36rpx; }
