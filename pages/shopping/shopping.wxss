/* 母题：图书馆索引卡 | 与 index / homework 同色板 */
page {
  background: #E7E2D6;
  color: #22201C;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}
.page { padding: 32rpx 36rpx 60rpx; }

/* ===== 摘要条 ===== */
.stat-strip {
  display: flex;
  align-items: flex-end;
  padding: 24rpx 28rpx;
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  position: relative;
}
.stat-strip::before {
  content: '';
  position: absolute;
  top: 0; left: 28rpx; right: 28rpx;
  height: 6rpx;
  background: #A4332B;
}
.ss-item { flex: 1; }
.ss-num {
  display: block;
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 56rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.ss-cap { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-top: 8rpx; display: block; }
.ss-div { width: 1rpx; height: 64rpx; background: #DAD4C6; margin: 0 24rpx; }

/* ===== 筛选 ===== */
.filter-row { display: flex; gap: 16rpx; margin: 32rpx 0 8rpx; }
.chip {
  font-size: 22rpx;
  color: #6E685C;
  border: 1rpx solid #DAD4C6;
  padding: 6rpx 24rpx;
  letter-spacing: 2rpx;
}
.chip.active { color: #22201C; border-color: #22201C; font-weight: 600; }

/* ===== 清单行 ===== */
.sh-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #DAD4C6;
}
.sh-check {
  width: 40rpx; height: 40rpx;
  border: 2rpx solid #C9C2B4;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #EFEBE0;
  margin-right: 20rpx;
  flex-shrink: 0;
  transition: background 160ms cubic-bezier(0.2, 0, 0, 1);
}
.sh-check.on { background: #3A5A40; border-color: #3A5A40; }
.sh-main { flex: 1; }
.sh-name { display: block; font-size: 27rpx; }
.sh-name.done { color: #6E685C; text-decoration: line-through; }
.sh-cat { display: block; font-size: 19rpx; color: #6E685C; margin-top: 3rpx; letter-spacing: 2rpx; }
.sh-est { font-size: 26rpx; font-weight: 600; margin-right: 16rpx; }
.sh-del { font-size: 30rpx; color: #C9C2B4; }

.empty {
  text-align: center;
  color: #6E685C;
  font-size: 22rpx;
  padding: 60rpx 0;
  letter-spacing: 2rpx;
}
.ops { display: flex; gap: 20rpx; margin-top: 32rpx; }
.btn {
  flex: 1;
  background: #EFEBE0;
  border: 1rpx solid #22201C;
  border-radius: 4rpx;
  font-size: 26rpx;
  color: #22201C;
  letter-spacing: 3rpx;
}
.btn.primary { background: #22201C; color: #EFEBE0; }
.btn.add-btn { border-style: dashed; }
.btn.ghost-btn { color: #6E685C; border-color: #DAD4C6; }

/* ===== 弹层 ===== */
.mask {
  position: fixed; inset: 0;
  background: rgba(34, 32, 28, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #E7E2D6;
  border: 1rpx solid #DAD4C6;
  border-bottom: none;
  padding: 32rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet-title {
  font-family: Georgia, "Songti SC", "SimSun", serif;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #22201C;
}
.form-row { margin-bottom: 20rpx; }
.fl { font-size: 20rpx; color: #6E685C; letter-spacing: 3rpx; margin-bottom: 8rpx; }
.field {
  background: #EFEBE0;
  border: 1rpx solid #DAD4C6;
  border-radius: 4rpx;
  padding: 14rpx 18rpx;
  font-size: 27rpx;
}
.form-2col { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.form-col { flex: 1; }
.sheet-ops { display: flex; gap: 20rpx; }
