.qa-mask {
  position: fixed; inset: 0;
  background: rgba(43, 38, 32, 0.45);
  z-index: 200;
  display: flex; align-items: flex-end; justify-content: center;
}
.qa-sheet {
  width: 100%;
  background: #F5F3ED;
  border-radius: 28rpx 28rpx 0 0;
  /* 底部预留 tabBar 高度：自定义 tabBar 是原生层级，压页面 fixed 弹层 */
  padding: 32rpx 28rpx calc(28rpx + 100rpx + env(safe-area-inset-bottom));
}
.qa-head { display: flex; align-items: baseline; margin-bottom: 20rpx; }
.qa-title { font-size: 34rpx; font-weight: 600; }
.qa-sub { font-size: 22rpx; color: #9A917F; margin-left: 16rpx; }
.qa-input {
  width: 100%;
  min-height: 140rpx;
  background: #FDFCF9;
  border: 1rpx solid #EDE7DB;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.qa-preview {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #FDFCF9;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #2B2620;
}
.qa-preview-text { margin-left: 8rpx; }
.qa-ops { display: flex; gap: 20rpx; margin-top: 22rpx; }
.qa-btn { flex: 1; }
.qa-hint {
  margin-top: 18rpx;
  font-size: 20rpx;
  color: #9A917F;
  text-align: center;
}
