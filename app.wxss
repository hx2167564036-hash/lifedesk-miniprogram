/* 设计系统：暖纸底 + 账本风格（与 HTML 版同源） */
page {
  --bg: #F5F3ED;
  --card: #FDFCF9;
  --ink: #2B2620;
  --ink2: #6B6357;
  --ink3: #9A917F;
  --line: #EDE7DB;
  --accent: #A2402A;
  --accent-soft: #F6EAE5;
  --red: #B03A2E;
  --green: #3F6B4F;
  --amber: #B8862B;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.serif { font-family: Georgia, "Songti SC", "SimSun", serif; }
.mono { font-family: "SF Mono", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
.muted { color: var(--ink2); }
.faint { color: var(--ink3); }
.red { color: var(--red); }
.green { color: var(--green); }
.accent { color: var(--accent); }

.card {
  background: var(--card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(43, 38, 32, 0.04);
}

.sec-head { display: flex; align-items: baseline; margin-bottom: 18rpx; }
.sec-label { font-size: 20rpx; letter-spacing: 2rpx; color: var(--ink3); margin-right: 12rpx; }
.sec-title { font-size: 30rpx; font-weight: 600; }
.sec-line { flex: 1; height: 1rpx; background: var(--line); margin: 0 14rpx; }
.sec-mini { font-size: 22rpx; color: var(--ink3); }

.ledger-row {
  display: flex; align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.ledger-row:last-child { border-bottom: none; }

.btn {
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 2.4;
  text-align: center;
  background: #EFEAE0;
  color: var(--ink);
}
.btn.primary { background: var(--accent); color: #FFF; }
.btn.sm { font-size: 22rpx; line-height: 2.1; padding: 0 24rpx; }
.btn[disabled] { opacity: 0.5; }

.chip {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  background: #EFEAE0;
  color: var(--ink2);
  font-size: 22rpx;
  margin-right: 14rpx;
}
.chip.active { background: var(--accent); color: #FFF; }

.field {
  background: #F6F2EA;
  border: 1rpx solid var(--line);
  border-radius: 10rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  height: auto;
  min-height: 64rpx;
}
.fl { display: block; font-size: 20rpx; color: var(--ink3); margin-bottom: 8rpx; }

.mask {
  position: fixed; inset: 0;
  background: rgba(43, 38, 32, 0.45);
  z-index: 100;
  display: flex; align-items: flex-end; justify-content: center;
}
.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 28rpx 28rpx 0 0;
  /* 底部预留 tabBar 高度（100rpx）：自定义 tabBar 是原生层级，会压住页面 fixed 弹层 */
  padding: 32rpx 28rpx calc(32rpx + 100rpx + env(safe-area-inset-bottom));
  max-height: 86vh;
  overflow-y: auto;
}
.sheet-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }

.empty {
  text-align: center;
  color: var(--ink3);
  font-size: 24rpx;
  padding: 60rpx 0;
}

/* ===== 批量导入通用（course / gpa 共用） ===== */
.ops { display: flex; gap: 20rpx; margin-top: 32rpx; }
.ops .btn { flex: 1; }
.btn.ghost-btn { color: #6E685C; border-color: #DAD4C6; }
.fmt-card {
  background: #FDFCF9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}
.fmt-title { font-size: 24rpx; font-weight: 600; margin-bottom: 8rpx; }
.fmt-code {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  margin-bottom: 8rpx;
}
.fmt-sub { font-size: 20rpx; color: var(--ink3); }
.ta {
  width: 100%;
  min-height: 200rpx;
  background: #FDFCF9;
  border: 1rpx solid #EDE7DB;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.parse-btn { margin: 16rpx 0; }
.parse-result {
  background: #FDFCF9;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 22rpx;
  max-height: 300rpx;
  overflow-y: auto;
}
.pr-head { font-weight: 600; margin-bottom: 8rpx; }
.pr-head.green { color: #3F6B4F; }
.pr-head.red { color: #B03A2E; }
.pr-item {
  font-size: 21rpx;
  color: #2B2620;
  padding: 4rpx 0;
  border-bottom: 1rpx solid #F0EAE0;
}
.pr-item:last-child { border-bottom: none; }

.tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 2rpx 14rpx;
  border-radius: 6rpx;
  background: var(--accent-soft);
  color: var(--accent);
  margin-right: 10rpx;
}
.tag.warn { background: #F9EFE0; color: var(--amber); }
.tag.danger { background: #F7E7E4; color: var(--red); }
